# Copia este fichero a files/.env y rellena tus claves.
#
# Pexels (gratis): https://www.pexels.com/api/
# Necesaria para el B-roll de fondo. Sin ella el vídeo cae a un fondo degradado.
PEXELS_API_KEY=

# Pixabay (gratis, opcional): https://pixabay.com/api/docs/
# Segunda fuente de clips. Sin ella el sistema funciona solo con Pexels.
PIXABAY_API_KEY=

# La música NO necesita ninguna clave: se busca en Incompetech y Openverse.
# Los trailers del fondo tampoco: salen de YouTube y de las fichas de Steam.

# Cookies del navegador para yt-dlp (opcional, vacío o "chrome"/"firefox").
# Los trailers de juegos para adultos están tras la verificación de edad de
# YouTube: sin sesión se saltan y se usa otro trailer, que suele bastar. Ponlo
# solo si ves que faltan vídeos de juegos +18.
YT_COOKIES_NAVEGADOR=

# Anthropic (OPCIONAL y de pago): https://console.anthropic.com/
# Si está vacía, los guiones se generan con el CLI de Claude Code
# (`claude -p`), que usa tu suscripción y no cuesta nada extra.
ANTHROPIC_API_KEY=
